# ===================================================
# ChangeGuard Environment Configuration Template
# ===================================================
# Copy this file to .env and adjust values for your local environment.
# NEVER commit sensitive production credentials or keys to source control.

# --- Spring Boot Backend Configuration ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/changeguard
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Alternative generic database env names supported by backend
DATABASE_URL=jdbc:postgresql://localhost:5432/changeguard
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Machine Learning Service URL (FastAPI) ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=3000

# --- Frontend Client Configuration (Vite) ---
# NOTE: VITE_* variables are exposed to the browser client.
# NEVER place private database passwords or API secrets in VITE_* variables!
VITE_API_BASE_URL=http://localhost:8080

# --- Docker Compose Environment Variables ---
POSTGRES_DB=changeguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8080
ML_SERVICE_PORT=8000
FRONTEND_PORT=3000

# --- Optional AI Studio Secrets ---
GEMINI_API_KEY=""


# --- GitHub Pull Request Integration ---
# Generate a random secret and use the same value in GitHub repository webhook settings.
CHANGEGUARD_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Fine-grained GitHub PAT: grant Issues read/write on the target repository to post PR comments.
CHANGEGUARD_GITHUB_TOKEN=github_pat_replace_me
# Exact owner/repository names mapped to ChangeGuard service IDs from the Services page.
# Example: my-github-user/payment-service:5,my-github-user/account-service:4
CHANGEGUARD_GITHUB_REPOSITORY_SERVICE_MAP=my-github-user/payment-service:5
